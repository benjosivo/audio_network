{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Network Sender",
  "version": "0.1.0",
  "identifier": "com.audionetwork.sender",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Audio Network - Sender",
        "width": 320,
        "height": 280,
        "minWidth": 280,
        "minHeight": 220
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
